# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://talknex_user:talknex_secret@localhost:5432/talknex_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,https://talknex.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Email SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@talknex.com
SALES_NOTIFICATION_EMAIL=sales@talknex.com

