# Copy this file to .env and add your real Groq API key.
GROQ_API_KEY=gsk_replace_this_with_your_real_key

# Choose models available in your Groq account.
# Check current model IDs: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

PORT=3000
NODE_ENV=development

# Optional: maximum conversation messages sent to Groq (including system message).
MAX_HISTORY_MESSAGES=18
